PORT=3000
# فريق الوكالة: اسم:رمز، افصل بينهم بفاصلة. كل عضو يدخل التطبيق برمزه.
TEAM=سارة:change-me-1,خالد:change-me-2,ريم:change-me-3,نواف:change-me-4,منى:change-me-5
# من إعدادات تطبيق Meta
META_APP_SECRET=
META_VERIFY_TOKEN=choose-any-long-random-string
# بعد كم دقيقة بدون رد يُعتبر الرد متأخراً
OVERDUE_MINUTES=30
# 1 = لا يرسل فعلياً للمنصات، يسجّل فقط (للتجربة)
DRY_RUN=1
