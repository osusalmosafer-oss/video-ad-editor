# انسخه إلى .env أو ضعه في متغيرات البيئة على الاستضافة
NODE_ENV=production
BASE_URL=https://your-domain.sa
ADMIN_PASSWORD=غيّرها-كلمة-طويلة-12-حرفًا-فأكثر
SESSION_SECRET=ولّد-نصًا-عشوائيًا-طويلًا   # openssl rand -hex 32
DATA_DIR=/var/data
WHATSAPP=9665XXXXXXXX

# بوابات الدفع — فعّل واحدة أو أكثر (تظهر تلقائيًا عند وجود المفتاح)
MOYASAR_SECRET_KEY=
TAP_SECRET_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_BASE_URL=https://secure.paytabs.sa

# إشعارات الحجز الجديد (تُرسل للوكالة، وتأكيد الدفع يُرسل أيضًا لبريد النزيل إن أدخله)
NOTIFY_EMAIL=            # بريد الوكالة (أو يؤخذ من الإعدادات)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=               # بريدك
SMTP_PASS=               # كلمة مرور التطبيقات (App Password) وليست كلمة مرور الحساب
MAIL_FROM="أسس المسافر <you@example.com>"
# واتساب: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=       # اسم قالب معتمد (موصى به). بدونه تصل رسالة نصية فقط ضمن نافذة 24 ساعة
WHATSAPP_TEMPLATE_LANG=ar
NOTIFY_WHATSAPP=         # رقم استقبال الإشعارات 9665XXXXXXXX (وإلا يؤخذ من الإعدادات)
